# Automatic HTTPS (Let's Encrypt) for {$SITE_DOMAIN}. Ports 80/443 must be reachable from the internet.
{$SITE_DOMAIN} {
	encode zstd gzip

	# API traffic goes straight to the backend so the real client IP reaches the rate limiter (TRUST_PROXY=1).
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle {
		reverse_proxy frontend:3000
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	request_body {
		max_size 1MB
	}
}
