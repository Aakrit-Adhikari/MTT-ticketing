# Copy to .env and replace EVERY placeholder. .env is git-ignored. Never commit real values.
# Generate secrets with:   openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'     (JWT)
#                          openssl rand -base64 32                                   (field encryption key)
#                          openssl rand -hex 24                                      (DB passwords: hex only!)

# ── Public site. Pick ONE of the three setups (A is best; the app always requires HTTPS, never plain HTTP).
#
# A) You have a domain (DNS A record pointing at the server; ports 80 and 443 free). Real certificate, automatic:
SITE_DOMAIN=tickets.example.com
FRONTEND_ORIGIN=https://tickets.example.com
PUBLIC_APP_URL=https://tickets.example.com
#
# B) No domain yet, ports 80/443 free: use a free name that points at your server's IP, e.g. IP 203.0.113.5 becomes
#    203-0-113-5.sslip.io  (real certificate, automatic). Put that name in all three lines above.
#
# C) No domain AND/OR ports 80/443 are taken by another program. Use the IP and your own ports. HTTPS uses a self-signed
#    certificate, so each browser shows a warning once (Advanced > Continue). Uncomment and edit:
#SITE_DOMAIN=203.0.113.5
#SITE_ADDRESS=203.0.113.5
#TLS_SNIPPET=tls_internal
#AUTO_HTTPS=disable_redirects
#HTTP_PORT=8080
#HTTPS_PORT=8443
#FRONTEND_ORIGIN=https://203.0.113.5:8443
#PUBLIC_APP_URL=https://203.0.113.5:8443
# (FRONTEND_ORIGIN must be exactly the address people type in the browser, including :8443.)
# Open HTTP_PORT and HTTPS_PORT in the server firewall. The frontend, backend and database use no host ports at all.

# ── PostgreSQL (db container). DB passwords: only A-Z a-z 0-9 _ - and >= 24 chars (enforced at init).
POSTGRES_DB=mtt
POSTGRES_SUPERUSER=mtt_bootstrap
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_hex_24_bytes
MIGRATOR_DB_PASSWORD=CHANGE_ME_hex_24_bytes
APP_DB_PASSWORD=CHANGE_ME_hex_24_bytes

# ── Backend (DATABASE_URL and TRUST_PROXY are assembled in docker-compose.yml)
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_random_chars
JWT_ISSUER=mtt-api
JWT_AUDIENCE=mtt-admin
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Separate from the JWT secret. Must decode to exactly 32 bytes. Losing it makes encrypted passenger fields unrecoverable.
FIELD_ENCRYPTION_KEY=CHANGE_ME_base64_of_32_random_bytes
HOLD_DEFAULT_MINUTES=120

# ── First administrator (created once by:  docker compose --profile ops run --rm create-admin)
# Use the real owner's email. Password: at least 12 characters. Delete ADMIN_PASSWORD from .env after the first run.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=CHANGE_ME_at_least_12_chars

# ── Email (REQUIRED in production: customers receive their booking reference and ticket by email)
# Use your email provider's SMTP details (e.g. Gmail app password, Brevo, Mailgun, Amazon SES).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_company_email@example.com
SMTP_PASSWORD=CHANGE_ME_app_password_no_spaces
MAIL_FROM="Mountain Tours and Travels Ticketing <tickets@example.com>"
# Staff addresses (comma-separated) that get an email when a customer requests a cancellation/refund or date change
STAFF_NOTIFY_EMAIL=staff@example.com
# Printed on receipts
AGENCY_NAME=Mountain Tours and Travels Ticketing
